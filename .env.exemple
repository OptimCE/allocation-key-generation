# Template for local development — copy to .env.local and adjust the values.
# The config loader (core/config.py) reads .env.<ENV>; with ENV=local it loads
# .env.local. See .env.staging.exemple / .env.production.exemple for the other
# environments, and .env.test for the test settings.
#
# When running inside the monorepo dev stack, replace the localhost hosts below
# with the compose service names (e.g. allocation-key-db, crm-database, nats,
# minio).

# ── Core ──
ENV=local

# ── CRM database (read) ──
CRM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm
CRM_DB_POOL_SIZE=20
CRM_DB_MAX_OVERFLOW=10
CRM_DB_POOL_RECYCLE=3600
CRM_DB_POOL_TIMEOUT=30
CRM_DB_SSL=false

# ── Local database (this service's own schema) ──
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/allocation_keys
LOCAL_DB_POOL_SIZE=20
LOCAL_DB_MAX_OVERFLOW=10
LOCAL_DB_POOL_RECYCLE=3600
LOCAL_DB_POOL_TIMEOUT=30
LOCAL_DB_SSL=false

# ── NATS ──
# Required in staging/production; may be left empty locally if you only run the
# API (the worker needs it to receive generation jobs).
NATS_URL=nats://localhost:4222

# ── Storage (S3-compatible, MinIO in dev) ──
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=crm-files
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# ── CORS ──
# Comma-separated list of allowed origins. "*" is allowed only in local.
ALLOW_ORIGIN=*

# ── Observability (optional locally, required in production) ──
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
